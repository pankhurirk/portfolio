{
  "name": "job-finder-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "triggers": { "crons": ["15 6,18 * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "EMPLOYER_SOURCES": "[{\"type\":\"greenhouse\",\"board\":\"gitlab\",\"company\":\"GitLab\",\"industry\":\"IT and software\"},{\"type\":\"greenhouse\",\"board\":\"anthropic\",\"company\":\"Anthropic\",\"industry\":\"IT and software\"},{\"type\":\"greenhouse\",\"board\":\"databricks\",\"company\":\"Databricks\",\"industry\":\"IT and software\"}]"
  }
  // Add SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as Worker secrets.
  // Existing ADZUNA_APP_ID / ADZUNA_APP_KEY secrets stay in Cloudflare.
}
